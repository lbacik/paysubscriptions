{
  "openapi": "3.0.3",
  "info": {
    "title": "PaySubscriptions API",
    "version": "1.0.0",
    "description": "Versioned REST API for User-owned resources. This hand-written document covers the resources not yet migrated to API Platform; ExpenseCategory (/expense-categories), Subscription (/subscriptions) and the dashboard snapshot report (issue #99) are served by API Platform and described by its generated document (/api/docs.jsonopenapi). It covers the published v1 OpenAPI contract endpoint (/openapi.json). Additive backward-compatible changes stay within v1; breaking changes require a new version."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "paySubsOAuth2": [
        "api:full"
      ]
    }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Published v1 OpenAPI contract",
        "security": [
          {
            "paySubsOAuth2": [
              "api:full"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "The v1 OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "paySubsOAuth2": {
        "type": "oauth2",
        "description": "User-delegated authorization code with S256 PKCE. Manually registered clients only; explicit scope api:full; 15-minute access tokens issued by this server.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/authorize",
            "tokenUrl": "/token",
            "refreshUrl": "/token",
            "scopes": {
              "api:full": "Full read/write access to the approving User's data."
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Stable problem type URI."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string",
            "description": "Safe human-readable detail; never leaks another User's data."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. subscription_not_found."
          },
          "errors": {
            "type": "array",
            "description": "Field-level violations for 422 write operations.",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Valid token without api:full scope, unapproved client, or ineligible account.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
