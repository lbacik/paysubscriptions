{# Floating Prototype Switcher for evaluating UI directions #}
<div id="prototype-switcher" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-slate-900/95 text-white backdrop-blur-md px-4 py-2.5 rounded-full shadow-2xl border border-slate-700/70 text-xs sm:text-sm font-sans select-none animate-fade-in" role="toolbar" aria-label="Prototype Variant Switcher">
    <div class="flex items-center gap-1.5 border-r border-slate-700 pr-3 mr-1 text-slate-400">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-semibold uppercase tracking-wider text-[11px] text-slate-300">Prototype</span>
    </div>

    <!-- Prev button -->
    <button type="button" id="proto-prev-btn" class="p-1.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-full transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-emerald-400" title="Previous variant (Left arrow)">
        <i class="fa-solid fa-chevron-left text-xs" aria-hidden="true"></i>
        <span class="sr-only">Previous variant</span>
    </button>

    <!-- Variant selector tabs / pills -->
    <div class="flex items-center gap-1">
        {% set variants = [
            {'id': 'A', 'label': 'A: Bento Pulse', 'desc': 'Kompaktowy SaaS Bento Grid'},
            {'id': 'B', 'label': 'B: Split Showcase', 'desc': 'Wielowarstwowy Hero 3D'},
            {'id': 'C', 'label': 'C: Live Simulator', 'desc': 'Interaktywny symulator'},
            {'id': 'original', 'label': 'Oryginał', 'desc': 'Poprzedni układ'}
        ] %}

        {% for v in variants %}
            <a href="?variant={{ v.id }}" 
               class="px-3 py-1.5 rounded-full font-medium transition-all duration-150 {{ currentVariant == v.id ? 'bg-emerald-500 text-slate-950 font-bold shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800' }}"
               title="{{ v.desc }}">
                {{ v.label }}
            </a>
        {% endfor %}
    </div>

    <!-- Next button -->
    <button type="button" id="proto-next-btn" class="p-1.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-full transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-emerald-400" title="Next variant (Right arrow)">
        <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
        <span class="sr-only">Next variant</span>
    </button>

    <div class="hidden md:flex items-center text-[10px] text-slate-400 border-l border-slate-700 pl-3 ml-1">
        <span>Użyj klawiszy <kbd class="px-1 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-200">←</kbd> <kbd class="px-1 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-200">→</kbd></span>
    </div>
</div>

<script>
    (function() {
        const variants = ['A', 'B', 'C', 'original'];
        const currentVariant = '{{ currentVariant }}';
        let currentIndex = variants.indexOf(currentVariant);
        if (currentIndex === -1) currentIndex = 0;

        function navigateToVariant(index) {
            const nextVariant = variants[(index + variants.length) % variants.length];
            const url = new URL(window.location.href);
            url.searchParams.set('variant', nextVariant);
            window.location.href = url.toString();
        }

        document.getElementById('proto-prev-btn')?.addEventListener('click', () => {
            navigateToVariant(currentIndex - 1);
        });

        document.getElementById('proto-next-btn')?.addEventListener('click', () => {
            navigateToVariant(currentIndex + 1);
        });

        window.addEventListener('keydown', (e) => {
            // Ignore if active element is form input
            const active = document.activeElement;
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable)) {
                return;
            }
            if (e.key === 'ArrowLeft') {
                e.preventDefault();
                navigateToVariant(currentIndex - 1);
            } else if (e.key === 'ArrowRight') {
                e.preventDefault();
                navigateToVariant(currentIndex + 1);
            }
        });
    })();
</script>
