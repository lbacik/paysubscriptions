{% extends 'base.html.twig' %}

{% block title %}PaySubscriptions — See what your subscriptions add up to{% endblock %}

{% block metaheaders %}
    <meta name="description" content="Track your subscriptions in one place and compare monthly and yearly costs. Free for up to {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions. No bank connection or payment card required.">
{% endblock %}

{% block body %}
<div class="relative overflow-hidden">
    <!-- Subtle gradient background highlight -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-blue-100/60 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-96 -left-40 w-80 h-80 bg-red-100/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 relative z-10">
        <!-- Hero Section -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
            
            <!-- Left Column: Value Proposition & CTA -->
            <div class="lg:col-span-7 flex flex-col items-start">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Free for up to {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions • No bank connection</span>
                </div>

                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
                    See what your <span class="text-color-ter underline decoration-color-qui decoration-4 underline-offset-6">subscriptions</span> really add up to.
                </h1>

                <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed max-w-xl">
                    Streaming, cloud storage, software, fitness... small recurring costs quietly add up. 
                    <strong>PaySubscriptions</strong> gives you a clean, honest overview of your monthly and yearly spending — with zero access to your bank account.
                </p>

                <!-- Primary CTA buttons -->
                <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}" class="btn-cta text-center">
                            Go to your dashboard
                            <i class="fa-solid fa-arrow-right ml-2 text-sm"></i>
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="btn-cta text-center">
                            Create your free account
                            <i class="fa-solid fa-arrow-right ml-2 text-sm"></i>
                        </a>
                    {% endif %}
                    <a href="#how-it-works" class="btn-secondary text-center">
                        See how it works
                    </a>
                </div>

                <!-- Reassurance Micro-copy -->
                <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-slate-500">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-check text-emerald-600"></i>
                        <span>No credit card required</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-check text-emerald-600"></i>
                        <span>Up to {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-check text-emerald-600"></i>
                        <span>100% private</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Realistic Product UI Mockup -->
            <div class="lg:col-span-5">
                <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xl overflow-hidden transform hover:-translate-y-1 transition duration-300">
                    <!-- Window Chrome -->
                    <div class="bg-slate-100/90 px-4 py-3 border-b border-slate-200 flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
                            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
                            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
                        </div>
                        <span class="text-xs font-medium text-slate-500">PaySubscriptions — Dashboard Demo</span>
                        <div class="w-10"></div>
                    </div>

                    <!-- App Mockup Content -->
                    <div class="p-5 space-y-4">
                        <!-- Summary Cards -->
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <div class="text-xs text-slate-500 font-medium">Monthly Total</div>
                                <div class="text-xl font-bold text-slate-900 mt-0.5">$59.46 <span class="text-xs font-normal text-slate-500">/ mo</span></div>
                            </div>
                            <div class="bg-blue-50/60 rounded-xl p-3 border border-blue-100">
                                <div class="text-xs text-color-ter font-medium">Yearly Equivalent</div>
                                <div class="text-xl font-bold text-color-ter mt-0.5">$713.52 <span class="text-xs font-normal text-slate-500">/ yr</span></div>
                            </div>
                        </div>

                        <!-- Sample Subscriptions List -->
                        <div class="space-y-2 pt-1">
                            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Sample Subscriptions</div>

                            <!-- Row 1: Netflix -->
                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100/80 transition-colors border border-slate-100">
                                <div class="flex items-center space-x-3">
                                    <div class="w-8 h-8 rounded-lg bg-red-100 text-red-600 flex items-center justify-center font-bold text-xs">
                                        <i class="fa-solid fa-film"></i>
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-800">Netflix Standard</div>
                                        <div class="text-xs text-slate-400">Monthly renewal</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-bold text-slate-900">$15.49</div>
                                    <div class="text-xs text-slate-400">$185.88 / yr</div>
                                </div>
                            </div>

                            <!-- Row 2: Spotify -->
                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100/80 transition-colors border border-slate-100">
                                <div class="flex items-center space-x-3">
                                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-xs">
                                        <i class="fa-solid fa-music"></i>
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-800">Spotify Family</div>
                                        <div class="text-xs text-slate-400">Monthly renewal</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-bold text-slate-900">$16.99</div>
                                    <div class="text-xs text-slate-400">$203.88 / yr</div>
                                </div>
                            </div>

                            <!-- Row 3: iCloud+ -->
                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100/80 transition-colors border border-slate-100">
                                <div class="flex items-center space-x-3">
                                    <div class="w-8 h-8 rounded-lg bg-sky-100 text-sky-600 flex items-center justify-center font-bold text-xs">
                                        <i class="fa-solid fa-cloud"></i>
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-800">iCloud+ 200 GB</div>
                                        <div class="text-xs text-slate-400">Monthly renewal</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-bold text-slate-900">$2.99</div>
                                    <div class="text-xs text-slate-400">$35.88 / yr</div>
                                </div>
                            </div>

                            <!-- Row 4: Annual tool -->
                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100/80 transition-colors border border-slate-100">
                                <div class="flex items-center space-x-3">
                                    <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center font-bold text-xs">
                                        <i class="fa-solid fa-laptop-code"></i>
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-800">Developer Tools Pack</div>
                                        <div class="text-xs text-purple-600 font-medium">$287.88 / year</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-bold text-slate-900">$23.99 <span class="text-xs font-normal text-slate-400">eq.</span></div>
                                    <div class="text-xs text-slate-400">$287.88 / yr</div>
                                </div>
                            </div>
                        </div>

                        <!-- Progress info -->
                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                            <span>4 of {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} slots used</span>
                            <span class="text-emerald-600 font-medium">Free plan active</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: Why PaySubscriptions? (Benefits) -->
        <div class="mt-28">
            <div class="text-center max-w-3xl mx-auto">
                <h2 class="text-3xl font-bold text-slate-900 tracking-tight sm:text-4xl">
                    Take back control of your recurring spend
                </h2>
                <p class="mt-4 text-lg text-slate-600">
                    A simple, focused tool designed to give you clarity without the privacy risks of linking your financial accounts.
                </p>
            </div>

            <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-blue-100 text-color-ter flex items-center justify-center text-xl mb-5">
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">One Honest Total</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Compare monthly and annual equivalents side-by-side. See what that "$10 here and $15 there" truly costs you over the course of a full year.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl mb-5">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">100% Privacy First</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        No bank credentials required, no automated inbox scraping, and no transaction data shared with marketers. You enter only what you choose to track.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-rose-100 text-color-qui flex items-center justify-center text-xl mb-5">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Visual Breakdown</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Explore your costs through clean, interactive charts. Spot which category drains your budget and easily decide what is worth keeping.
                    </p>
                </div>
            </div>
        </div>

        <!-- Section 3: How it Works (3 Steps) -->
        <div id="how-it-works" class="mt-28 bg-white rounded-3xl border border-slate-200/80 p-8 sm:p-12 shadow-sm">
            <div class="max-w-2xl mb-12">
                <span class="text-xs font-bold text-color-ter uppercase tracking-wider">How PaySubscriptions Works</span>
                <h2 class="text-3xl font-bold text-slate-900 tracking-tight mt-2">
                    Start tracking in 3 simple steps
                </h2>
                <p class="mt-3 text-slate-600">
                    No complicated onboarding or banking integrations. Just straightforward visibility into your subscriptions.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                <!-- Step 1 -->
                <div class="flex flex-col">
                    <div class="w-10 h-10 rounded-xl bg-color-qua text-white flex items-center justify-center font-bold text-lg mb-4">
                        1
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Add your services</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Enter the service name, first payment date, and choose whether it's billed monthly or yearly.
                    </p>
                </div>

                <!-- Step 2 -->
                <div class="flex flex-col">
                    <div class="w-10 h-10 rounded-xl bg-color-ter text-white flex items-center justify-center font-bold text-lg mb-4">
                        2
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Review your equivalents</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        PaySubscriptions calculates normalized monthly and yearly equivalents automatically, giving you the real total.
                    </p>
                </div>

                <!-- Step 3 -->
                <div class="flex flex-col">
                    <div class="w-10 h-10 rounded-xl bg-color-qui text-white flex items-center justify-center font-bold text-lg mb-4">
                        3
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Keep your list up to date</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Update prices as plans change, or remove services you've decided to cancel. Your overview always reflects your current choices.
                    </p>
                </div>
            </div>

            <div class="mt-10 pt-8 border-t border-slate-100 flex items-center justify-between flex-wrap gap-4">
                <span class="text-sm text-slate-600">Want to know more about the project philosophy?</span>
                <a href="{{ path('app_docs') }}" class="text-sm font-semibold text-color-ter hover:text-slate-900 underline flex items-center gap-1.5">
                    Read the About page <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>
        </div>

        <!-- Section 4: Final Call to Action Banner -->
        <div class="mt-28 bg-gradient-to-br from-slate-900 to-color-qua text-white rounded-3xl p-8 sm:p-12 text-center relative overflow-hidden shadow-xl">
            <div class="max-w-2xl mx-auto relative z-10">
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
                    Ready to see what you're really paying?
                </h2>
                <p class="mt-4 text-slate-300 text-base sm:text-lg">
                    Join PaySubscriptions today. Track up to {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions with no cards, no fees, and no bank integration.
                </p>
                <div class="mt-8 flex justify-center">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}" class="btn-cta">
                            Go to your dashboard
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="btn-cta">
                            Create your free account
                            <i class="fa-solid fa-arrow-right ml-2 text-sm"></i>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
