{% extends 'base.html.twig' %}

{% block title %}PaySubscriptions — Know what you pay. See what renews next.{% endblock %}

{% block metaheaders %}
    <meta name="description" content="Know what you pay. See what renews next. PaySubscriptions keeps subscriptions and household bills in one manual-first place — no bank connection or payment card required.">
{% endblock %}

{% block body %}
<main class="relative overflow-hidden">
    <!-- Quiet slate/blue ambient surfaces -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-blue-100/50 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-96 -left-40 w-80 h-80 bg-slate-200/50 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 relative z-10">
        <!-- Hero: outcome-led headline + illustrative upcoming-renewals preview -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

            <!-- Left Column: Value Proposition & CTA -->
            <div class="lg:col-span-7 flex flex-col items-start">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold uppercase tracking-wider text-color-ter mb-6">
                    A clearer view of recurring costs
                </span>

                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
                    Know what you pay. See what renews next.
                </h1>

                <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed max-w-xl">
                    Keep subscriptions and household bills in one place. See the next charges,
                    understand your totals, and choose whether to get a reminder before renewal.
                    No bank connection needed.
                </p>

                <!-- Primary CTA buttons -->
                <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}" class="btn-cta text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-color-ter">
                            Go to your dashboard
                            <i class="fa-solid fa-arrow-right ml-2 text-sm" aria-hidden="true"></i>
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="btn-cta text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-color-ter">
                            Create your free account
                            <i class="fa-solid fa-arrow-right ml-2 text-sm" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    <a href="#how-it-works" class="btn-secondary text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-color-ter">
                        See how it works
                    </a>
                </div>

                <!-- Reassurance Micro-copy -->
                <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-slate-500">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-check text-emerald-600" aria-hidden="true"></i>
                        <span>No credit card required</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-check text-emerald-600" aria-hidden="true"></i>
                        <span>Up to {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-check text-emerald-600" aria-hidden="true"></i>
                        <span>No bank connection</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Illustrative upcoming-renewals preview (never a real record) -->
            <div class="lg:col-span-5">
                <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xl overflow-hidden" aria-label="Illustrative example of the planned upcoming-renewals view. Not your data.">
                    <!-- Window Chrome -->
                    <div class="bg-slate-100/90 px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-3">
                        <span class="text-xs font-semibold text-slate-700">Upcoming renewals</span>
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Illustrative example</span>
                    </div>

                    <!-- Preview Content -->
                    <div class="p-5 space-y-3">
                        <div>
                            <div class="text-xs text-slate-500 font-medium">Next 30 days</div>
                            <div class="text-2xl font-extrabold text-slate-900 tracking-tight mt-0.5">3 charges</div>
                        </div>

                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                            <span class="text-sm font-semibold text-slate-800">Music plan</span>
                            <span class="text-sm text-slate-500">Oct 4 · €12.00</span>
                        </div>
                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                            <span class="text-sm font-semibold text-slate-800">Home internet</span>
                            <span class="text-sm text-slate-500">Oct 9 · €35.00</span>
                        </div>
                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                            <span class="text-sm font-semibold text-slate-800">Cloud storage</span>
                            <span class="text-sm text-slate-500">Oct 21 · €3.00</span>
                        </div>

                        <p class="pt-1 text-xs text-slate-500">
                            Example entries and dates — not your data, not a real transaction.
                            This view shows the planned v1.0 design.
                        </p>
                    </div>
                </div>
                <p class="mt-3 flex items-center gap-2 text-xs text-slate-500">
                    <span class="inline-block px-2.5 py-1 rounded-full bg-orange-100 text-orange-800 font-bold whitespace-nowrap">Planned for v1.0</span>
                    <span>Upcoming renewals and optional email reminders</span>
                </p>
            </div>
        </div>

        <!-- How it works: three-step explanation -->
        <section id="how-it-works" aria-labelledby="how-it-works-title" class="mt-28">
            <span class="text-xs font-bold text-color-ter uppercase tracking-wider">How it works</span>
            <h2 id="how-it-works-title" class="text-3xl font-bold text-slate-900 tracking-tight sm:text-4xl mt-2">
                From scattered renewals to one useful overview.
            </h2>

            <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Step 1 -->
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm">
                    <div class="text-sm font-extrabold text-color-qui mb-4" aria-hidden="true">01</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Add what you pay for</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Enter a name, amount, currency and monthly or yearly cycle.
                        Group it with a category that makes sense to you.
                    </p>
                </div>

                <!-- Step 2 -->
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm">
                    <div class="text-sm font-extrabold text-color-qui mb-4" aria-hidden="true">02</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">See the dates and totals</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Review upcoming renewals and compare recurring spend in your main currency.
                        Enter your own converted amount when currencies differ.
                    </p>
                </div>

                <!-- Step 3 -->
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm">
                    <div class="text-sm font-extrabold text-color-qui mb-4" aria-hidden="true">03</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Decide in time</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Keep the upcoming list in view. Turn on email reminders
                        if you want an extra nudge before the next charge.
                    </p>
                </div>
            </div>
        </section>

        <!-- Data handling: brief section with honest boundaries -->
        <section aria-labelledby="data-handling-title" class="mt-28 bg-white rounded-3xl border border-slate-200/80 p-8 sm:p-12 shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-start">
                <div>
                    <span class="text-xs font-bold text-color-ter uppercase tracking-wider">How your data is handled</span>
                    <h2 id="data-handling-title" class="text-3xl font-bold text-slate-900 tracking-tight mt-2">
                        Clear boundaries for what you enter.
                    </h2>
                    <p class="mt-4 text-slate-600 leading-relaxed">
                        You choose which recurring costs to track. The v1.0 plan includes
                        a plain-language data-handling policy and a way to delete your account yourself.
                    </p>
                </div>
                <div class="grid gap-4">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80">
                        <span class="inline-block px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3">Available now</span>
                        <h3 class="text-lg font-bold text-slate-900">Manual entry, with no bank or inbox connection</h3>
                        <p class="text-slate-600 text-sm leading-relaxed mt-2">
                            PaySubscriptions tracks only the details you add yourself.
                            There is no bank connection, inbox scan, or provider cancellation.
                        </p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80">
                        <span class="inline-block px-2.5 py-1 rounded-full bg-orange-100 text-orange-800 text-xs font-bold mb-3">Planned for v1.0</span>
                        <h3 class="text-lg font-bold text-slate-900">A published data-handling policy and account deletion</h3>
                        <p class="text-slate-600 text-sm leading-relaxed mt-2">
                            The policy will name each external service and the data it receives —
                            including page-view analytics — and explain storage and sharing.
                            Account and subscription data is not sold.
                            Self-service account deletion is a release goal;
                            the newsletter stays a separate opt-in with its own unsubscribe path.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Build status: honest current-versus-planned -->
        <section aria-labelledby="build-status-title" class="mt-28 bg-slate-100/70 rounded-3xl border border-slate-200/80 p-8 sm:p-12">
            <span class="text-xs font-bold text-color-ter uppercase tracking-wider">Build status</span>
            <h2 id="build-status-title" class="text-3xl font-bold text-slate-900 tracking-tight mt-2">
                What exists, and what this design proposes.
            </h2>

            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm">
                    <span class="inline-block px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3">Available now</span>
                    <h3 class="text-xl font-bold text-slate-900">A manual subscription tracker</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mt-2">
                        Track monthly or yearly amounts and compare monthly and annual equivalents
                        in a single-owner account.
                    </p>
                </div>
                <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-sm">
                    <span class="inline-block px-2.5 py-1 rounded-full bg-orange-100 text-orange-800 text-xs font-bold mb-3">Planned for v1.0</span>
                    <h3 class="text-xl font-bold text-slate-900">Renewal clarity and data control</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mt-2">
                        Upcoming dates, optional reminders, categories, a published data-handling policy
                        and self-service account deletion are release goals, pending implementation and verification.
                    </p>
                </div>
            </div>
        </section>

        <!-- Closing CTA -->
        <section aria-labelledby="closing-title" class="mt-28 text-center">
            <h2 id="closing-title" class="text-3xl font-bold text-slate-900 tracking-tight sm:text-4xl">
                Start with a clearer picture.
            </h2>
            <p class="mt-4 text-lg text-slate-600 max-w-xl mx-auto">
                A focused, free way to keep recurring costs visible without connecting a bank.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4">
                {% if app.user %}
                    <a href="{{ path('app_dashboard') }}" class="btn-cta text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-color-ter">
                        Go to your dashboard
                    </a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn-cta text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-color-ter">
                        Create your free account
                        <i class="fa-solid fa-arrow-right ml-2 text-sm" aria-hidden="true"></i>
                    </a>
                {% endif %}
                <a href="{{ path('app_docs') }}" class="text-sm font-semibold text-color-ter hover:text-slate-900 underline underline-offset-4">
                    About PaySubscriptions
                </a>
            </div>
        </section>
    </div>
</main>
{% endblock %}
