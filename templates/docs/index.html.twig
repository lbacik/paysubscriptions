{% extends 'base.html.twig' %}

{% block title %}{{ show }} — PaySubscriptions{% endblock %}

{% block metaheaders %}
    {% if show == 'About' %}
        <meta name="description" content="Learn how PaySubscriptions helps you track personal and household subscriptions, what is available today, and where the project is heading.">
    {% endif %}
{% endblock %}

{% block body %}
<div class="relative overflow-hidden py-12 md:py-20">
    <!-- Subtle gradient background highlight -->
    <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-blue-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Page Header -->
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-4">
                <i class="fa-solid fa-circle-info text-color-ter"></i>
                Product Transparency
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
                About PaySubscriptions
            </h1>
            <p class="mt-4 text-lg text-slate-600">
                A simple, privacy-focused way to keep tabs on recurring subscriptions without connecting your bank account.
            </p>
        </div>

        <!-- Trust Badges Bar -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
            <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <div>
                    <div class="text-xs font-bold text-slate-900">Zero Bank Access</div>
                    <div class="text-xs text-slate-500">Your bank credentials stay yours</div>
                </div>
            </div>

            <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-color-ter flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-calculator"></i>
                </div>
                <div>
                    <div class="text-xs font-bold text-slate-900">Calculated Totals</div>
                    <div class="text-xs text-slate-500">Monthly &amp; yearly equivalents</div>
                </div>
            </div>

            <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div>
                    <div class="text-xs font-bold text-slate-900">Private &amp; Free</div>
                    <div class="text-xs text-slate-500">No ads, no data selling</div>
                </div>
            </div>
        </div>

        <!-- Main Content Card -->
        <div class="bg-white rounded-3xl border border-slate-200/90 shadow-xl p-8 sm:p-14">
            {% if documentation.menuItems|length > 1 %}
                <div class="flex flex-wrap gap-2 mb-8 pb-6 border-b border-slate-100">
                    {% for section, chapters in documentation.menuItems %}
                        <a href="{{ path('app_docs', {section: section}) }}" 
                           class="px-4 py-2 rounded-xl text-sm font-semibold transition-colors {% if show == section %} bg-color-qua text-white {% else %} bg-slate-100 text-slate-600 hover:bg-slate-200 {% endif %}">
                            {{ section }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            <article class="prose prose-slate lg:prose-lg max-w-none 
                            prose-h1:hidden 
                            prose-h2:text-2xl prose-h2:font-bold prose-h2:text-slate-900 prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-slate-100 prose-h2:pb-2 
                            prose-p:text-slate-600 prose-p:leading-relaxed 
                            prose-li:text-slate-600 
                            prose-a:text-color-ter prose-a:font-semibold prose-a:underline hover:prose-a:text-slate-900">
                {{ documentation.content(show)|markdown_to_html }}
            </article>

            <!-- Bottom Support Box -->
            <div class="mt-12 pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-50 rounded-2xl p-6">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Have suggestions or feedback?</h3>
                    <p class="text-sm text-slate-500 mt-0.5">We are actively refining the product to make subscription tracking effortless.</p>
                </div>
                <a href="{{ path('app_contact') }}" class="btn-primary text-sm whitespace-nowrap">
                    Contact Maintainer
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
