{# Throwaway About-page prototype: /about?variant=A|B|C in dev only. #}
{% extends 'base.html.twig' %}

{% block title %}About prototype {{ variant }} — PaySubscriptions{% endblock %}

{% block stylesheets %}
<style>
    .wf-about { --ink:#172638; --muted:#536477; --line:#dbe3e9; --blue:#3b6489; --warm:#bf6759; color:var(--ink); background:#f7f9fa; }
    .wf-about * { box-sizing:border-box; }
    .wf-about h1,.wf-about h2,.wf-about h3,.wf-about p { margin:0; color:inherit; }
    .wf-about h1 { font-size:clamp(2.4rem,5vw,4.5rem); letter-spacing:-.055em; line-height:1.08; font-weight:800; }
    .wf-about h2 { font-size:clamp(1.7rem,3vw,2.6rem); letter-spacing:-.035em; line-height:1.17; font-weight:800; }
    .wf-about h3 { font-size:1.1rem; line-height:1.3; font-weight:800; }
    .wf-about p { line-height:1.65; }
    .wf-about a { text-decoration:none; }
    .wf-about .wrap { width:min(1120px,calc(100% - 2.5rem)); margin-inline:auto; }
    .wf-about .section { padding-block:4.5rem; }
    .wf-about .eyebrow { display:inline-block; color:var(--blue); font-size:.72rem; letter-spacing:.13em; text-transform:uppercase; font-weight:800; margin-bottom:1rem; }
    .wf-about .lede { color:var(--muted); font-size:clamp(1.05rem,1.7vw,1.25rem); max-width:43rem; margin-top:1.2rem; }
    .wf-about .muted { color:var(--muted); }
    .wf-about .tiny { color:var(--muted); font-size:.83rem; }
    .wf-about .panel { background:white; border:1px solid var(--line); border-radius:1.2rem; padding:1.6rem; }
    .wf-about .panel p { color:var(--muted); margin-top:.65rem; }
    .wf-about .tag { display:inline-block; background:#e7eee9; color:#286040; border-radius:999px; padding:.28rem .65rem; font-size:.72rem; font-weight:800; margin-bottom:.8rem; }
    .wf-about .tag.plan { background:#fff0e9; color:#914a35; }
    .wf-about .tag.future { background:#e8eef6; color:#315780; }
    .wf-about .link { color:#315e83; font-weight:800; text-decoration:underline; text-underline-offset:4px; }
    .wf-about .prototype-note { padding:.8rem 1.2rem; background:#20354a; color:white; text-align:center; font-size:.85rem; }
    .wf-about .prototype-note strong { color:#ffd8c5; }
    .wf-about .roadmap-note { color:var(--muted); font-size:.9rem; margin-top:1.2rem; max-width:49rem; }
    .wf-about .closing { border-top:1px solid var(--line); text-align:center; }
    .wf-about .closing .link { display:inline-block; margin-top:1.3rem; }

    .wf-a .hero { padding-block:5rem 4.4rem; display:grid; grid-template-columns:1.2fr .8fr; gap:4rem; align-items:center; }
    .wf-a .hero-card { border-left:5px solid var(--warm); box-shadow:0 18px 48px #17263816; }
    .wf-a .hero-card p { margin-top:.5rem; }
    .wf-a .hero-card .separate { border-top:1px solid var(--line); padding-top:1rem; margin-top:1.2rem; }

    .wf-b { background:#fbfaf6; }
    .wf-b .hero { background:#1e374c; color:white; padding-block:4.8rem; }
    .wf-b .hero .eyebrow,.wf-b .hero .lede { color:#d9e5ec; }
    .wf-b .hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center; }
    .wf-b .hero .panel { color:var(--ink); transform:rotate(1deg); }
    .wf-b .steps { display:grid; gap:1.1rem; margin-top:1rem; }
    .wf-b .step { display:grid; grid-template-columns:4.2rem 1fr; gap:1rem; border-top:1px solid var(--line); padding-top:1rem; }
    .wf-b .step strong { color:var(--warm); font-size:1.3rem; }
    .wf-b .step p { color:var(--muted); }
    .wf-a .roadmap,.wf-b .roadmap { display:grid; grid-template-columns:17rem 1fr; gap:3rem; }
    .wf-a .roadmap-list,.wf-b .roadmap-list { border-left:3px solid #e9b4a5; padding-left:1.5rem; }
    .wf-a .roadmap-list > div,.wf-b .roadmap-list > div { padding-bottom:1.6rem; }
    .wf-a .roadmap-list p,.wf-b .roadmap-list p { margin-top:.4rem; color:var(--muted); }
    .wf-b .truth { background:#edf2f3; border-block:1px solid var(--line); }
    .wf-b .truth-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:1.8rem; }

    .wf-c { background:#fffdf9; }
    .wf-c .hero { padding-block:4.7rem 3.6rem; }
    .wf-c .hero h1 { max-width:900px; }
    .wf-c .hero h1 em { font-style:normal; color:#ae5c53; }
    .wf-c .answer-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; margin-top:2rem; }
    .wf-c .answer-grid .panel { min-height:12rem; }
    .wf-a .boundary,.wf-c .boundary { background:#edf3ef; border-block:1px solid #d5e4dc; }
    .wf-a .boundary-grid,.wf-c .boundary-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:4rem; }
    .wf-a .boundary-list,.wf-c .boundary-list { display:grid; gap:1rem; }
    .wf-a .boundary-list > div,.wf-c .boundary-list > div { padding-bottom:1rem; border-bottom:1px solid #d5e4dc; }
    .wf-a .boundary-list p,.wf-c .boundary-list p { color:var(--muted); margin-top:.4rem; }
    .wf-c .roadmap-row { display:grid; grid-template-columns:7rem 1fr; gap:1rem; border-top:1px solid var(--line); padding:1.1rem 0; }
    .wf-c .roadmap-row p { color:var(--muted); }

    body nav.wf-about-switch { position:fixed; z-index:100; top:auto; bottom:3.5rem; left:50%; width:max-content; height:auto; transform:translateX(-50%); display:flex; flex-direction:row; align-items:center; gap:.65rem; padding:.45rem .6rem; background:#132336; color:white; border:1px solid #405269; border-radius:999px; box-shadow:0 18px 45px #17233470; font-size:.8rem; white-space:nowrap; }
    .wf-about-switch a { display:grid; place-items:center; width:2.1rem; height:2.1rem; border-radius:50%; color:white; font-size:1.2rem; }
    .wf-about-switch a:hover,.wf-about-switch a:focus-visible { background:#3f5874; }
    .wf-about-switch strong { min-width:12rem; text-align:center; }
    @media (max-width:800px) {
        .wf-a .hero,.wf-a .boundary-grid,.wf-a .roadmap,.wf-b .hero-grid,.wf-b .roadmap,.wf-c .boundary-grid { grid-template-columns:1fr; gap:2rem; }
        .wf-b .truth-grid,.wf-c .answer-grid { grid-template-columns:1fr; }
        .wf-about .section { padding-block:3rem; }
        .wf-b .hero .panel { transform:none; }
    }
    @media (max-width:480px) {
        .wf-about .wrap { width:calc(100% - 2rem); }
        .wf-a .hero,.wf-b .hero,.wf-c .hero { padding-block:3rem; }
        .wf-c .roadmap-row { grid-template-columns:1fr; gap:.3rem; }
    }
</style>
{% endblock %}

{% block body %}
<main class="wf-about wf-{{ variant|lower }}">
    <div class="prototype-note"><strong>About prototype {{ variant }}.</strong> Planned v1.0 copy is shown for design review. The live product has fewer capabilities.</div>
    {% if variant == 'A' %}
        <section class="wrap hero">
            <div><span class="eyebrow">About PaySubscriptions</span><h1>A clearer view of the costs that come back.</h1><p class="lede">PaySubscriptions is a free, manual-first tracker for one person managing their own subscriptions and household recurring costs. It is being shaped around a simple question: what will renew next, and can you act in time?</p></div>
            <div class="panel hero-card"><span class="tag">Available now</span><h3>Start with what exists</h3><p>Enter subscriptions yourself and review a list with monthly and yearly cost equivalents. One person owns each account.</p><div class="separate"><span class="tag plan">Planned for v1.0</span><p>Renewal dates, optional reminders, categories, a published privacy policy, and self-service account deletion still need to be built and verified.</p></div></div>
        </section>
        <section class="boundary section"><div class="wrap boundary-grid"><div><span class="eyebrow">Data handling</span><h2>Trust needs specifics.</h2><p class="lede">The published privacy policy is a v1.0 release goal. These disclosures belong in it before the product makes a broad trust claim.</p></div><div class="boundary-list"><div><h3>Manual entry, no integrations</h3><p>The product does not ingest bank transactions, messages, or provider accounts.</p></div><div><h3>Hosted page-view analytics</h3><p>Hosted Umami is used today. The planned policy must name it and explain the analytics exception to the no-third-party-sharing promise.</p></div><div><h3>Storage and control</h3><p>Subscription fields are not individually encrypted at rest. The planned policy must say so plainly, alongside account deletion and email-request export.</p></div></div></div></section>
        <section class="wrap section roadmap"><div><span class="eyebrow">Public roadmap concept</span><h2>Progress by outcome.</h2><p class="roadmap-note">This Now / Next / Later sequence is proposed for publication with v1.0. Now is not a claim about the current product.</p></div><div class="roadmap-list"><div><span class="tag plan">Now · v1.0 goal</span><h3>Know what is coming due</h3><p>Manual organization, renewal dates, totals, optional reminders, and account-data control.</p></div><div><span class="tag future">Next · explore</span><h3>Make records easier to keep current</h3><p>Possible import and self-service export, subject to feedback.</p></div><div><span class="tag future">Later · explore</span><h3>Make longer-range planning easier</h3><p>Possible automatic currency conversion and change history.</p></div><p class="roadmap-note">No dates, guaranteed sequence, or bank, email, and provider integrations.</p></div></section>
    {% elseif variant == 'B' %}
        <section class="hero"><div class="wrap hero-grid"><div><span class="eyebrow">About the project</span><h1>Build a useful habit around recurring costs.</h1><p class="lede">One owner, manual entry, and a focused path from knowing what you pay to knowing when it returns. No bank connection or shared household account.</p></div><div class="panel"><span class="tag plan">Proposed v1.0 journey</span><div class="steps"><div class="step"><strong>01</strong><div><h3>Record it</h3><p>Add a recurring cost and a cycle.</p></div></div><div class="step"><strong>02</strong><div><h3>See it coming</h3><p>Review upcoming renewals and totals.</p></div></div><div class="step"><strong>03</strong><div><h3>Choose a reminder</h3><p>Opt into email reminders or keep the overview in-app.</p></div></div></div><p class="tiny">Steps 2 and 3 describe planned work, not current behavior.</p></div></div></section>
        <section class="wrap section roadmap"><div><span class="eyebrow">Public roadmap concept</span><h2>Progress by outcome.</h2><p class="roadmap-note">This Now / Next / Later sequence is proposed for publication with v1.0. Now is not a claim about the current product.</p></div><div class="roadmap-list"><div><span class="tag plan">Now · v1.0 goal</span><h3>Know what is coming due</h3><p>Manual organization, renewal dates, totals, optional reminders, and account-data control.</p></div><div><span class="tag future">Next · explore</span><h3>Make records easier to keep current</h3><p>Possible import and self-service export, subject to feedback.</p></div><div><span class="tag future">Later · explore</span><h3>Make longer-range planning easier</h3><p>Possible automatic currency conversion and change history.</p></div><p class="roadmap-note">No dates, guaranteed sequence, or bank, email, and provider integrations.</p></div></section>
        <section class="truth section"><div class="wrap"><span class="eyebrow">Reality check</span><h2>What you can use today, and what is still planned.</h2><div class="truth-grid"><div class="panel"><span class="tag">Available now</span><h3>A manual subscription list</h3><p>Track entered subscriptions and compare monthly and yearly equivalents in your own account. No bank or inbox access.</p></div><div class="panel"><span class="tag plan">Planned for v1.0</span><h3>Renewal clarity and a documented data policy</h3><p>Upcoming dates, reminders, categories, self-service deletion, and a policy disclosing Umami analytics and storage practices require implementation and verification.</p></div></div></div></section>
    {% else %}
        <section class="wrap hero"><span class="eyebrow">About PaySubscriptions</span><h1>Questions worth answering <em>before you trust a tracker.</em></h1><p class="lede">What can you do today? What information does the service use? What is only a plan? Here are the boundaries behind the product story.</p><div class="answer-grid"><div class="panel"><span class="tag">Available now</span><h3>What does it track?</h3><p>Subscriptions you enter manually, with monthly and yearly cost equivalents. Each account has one owner, even when those costs serve a household.</p></div><div class="panel"><span class="tag">Available now</span><h3>Does it connect to my bank or email?</h3><p>No. PaySubscriptions does not connect to a bank or scan an inbox for subscriptions.</p></div><div class="panel"><span class="tag plan">Planned for v1.0</span><h3>Will it warn me before a renewal?</h3><p>An upcoming-renewals view and optional email reminders are release goals, pending implementation and verification.</p></div><div class="panel"><span class="tag plan">Planned for v1.0</span><h3>Can I delete or export my data?</h3><p>Self-service account deletion is planned. At v1.0, export is planned through an email request.</p></div></div></section>
        <section class="boundary section"><div class="wrap boundary-grid"><div><span class="eyebrow">Data handling</span><h2>Trust needs specifics.</h2><p class="lede">The published privacy policy is a v1.0 release goal. These disclosures belong in it before the product makes a broad trust claim.</p></div><div class="boundary-list"><div><h3>Manual entry, no integrations</h3><p>The product does not ingest bank transactions, messages, or provider accounts.</p></div><div><h3>Hosted page-view analytics</h3><p>Hosted Umami is used today. The planned policy must name it and explain the analytics exception to the no-third-party-sharing promise.</p></div><div><h3>Storage and control</h3><p>Subscription fields are not individually encrypted at rest. The planned policy must say so plainly, alongside account deletion and email-request export.</p></div></div></div></section>
        <section class="wrap section"><span class="eyebrow">Proposed public roadmap at v1.0 launch</span><h2>Outcomes, without dates.</h2><div class="roadmap-row"><div><span class="tag plan">Now</span></div><div><h3>Know what is coming due</h3><p>This describes the v1.0 release goal: upcoming renewals, clear totals, optional reminders, and control over account data. It is not all available today.</p></div></div><div class="roadmap-row"><div><span class="tag future">Next</span></div><div><h3>Keep records current</h3><p>Explore easier import and self-service export.</p></div></div><div class="roadmap-row"><div><span class="tag future">Later</span></div><div><h3>Plan further ahead</h3><p>Explore automatic currency conversion and change history.</p></div></div><p class="roadmap-note">Next and Later are candidate directions, not commitments. Bank, inbox, and provider integrations remain outside v1.0.</p></section>
    {% endif %}
    <section class="closing section"><div class="wrap"><h2>A focused, free tracker for recurring costs.</h2><p class="lede" style="margin-inline:auto;">The homepage explains the product experience. This prototype shows the About-page story and the boundaries behind it.</p><a class="link" href="{{ path('app_home') }}">Explore PaySubscriptions</a></div></section>
</main>
{% if app.environment == 'dev' %}
    {% set names = {'A':'Story + data + roadmap','B':'Journey + roadmap','C':'Questions + answers'} %}
    {% set previous = variant == 'A' ? 'C' : (variant == 'B' ? 'A' : 'B') %}
    {% set next = variant == 'A' ? 'B' : (variant == 'B' ? 'C' : 'A') %}
    <nav class="wf-about-switch" aria-label="About prototype variants" data-prototype-switcher>
        <a href="{{ path('app_docs', {variant: previous}) }}" aria-label="Previous variant" data-previous>←</a>
        <strong>{{ variant }} · {{ names[variant] }}</strong>
        <a href="{{ path('app_docs', {variant: next}) }}" aria-label="Next variant" data-next>→</a>
    </nav>
    <script>
        document.addEventListener('keydown', (event) => {
            if (!['ArrowLeft','ArrowRight'].includes(event.key) || event.altKey || event.ctrlKey || event.metaKey) return;
            if (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable]')) return;
            const selector = event.key === 'ArrowLeft' ? '[data-previous]' : '[data-next]';
            window.location.assign(document.querySelector('[data-prototype-switcher] ' + selector).href);
        });
    </script>
{% endif %}
{% endblock %}
