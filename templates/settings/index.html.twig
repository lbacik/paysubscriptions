{% extends 'base.html.twig' %}

{% block body %}

<twig:ContentCenter width="w-full px-10 md:px-0 md:w-1/3" class="mt-20">
    <div class="form" data-controller="timezone">

        <h1 class="mb-10 font-thin text-lg text-color-qua text-right border-b border-color-sec">{{ 'settings.title'|trans }}</h1>

        <p class="mb-6 text-sm text-gray-500">{{ 'settings.intro'|trans }}</p>

        {{ form_start(form) }}

        {{ form_errors(form) }}

        {{ form_row(form.emailRemindersEnabled) }}

        <p class="mb-6 text-sm text-gray-500">{{ 'settings.email_note'|trans }}</p>

        {{ form_row(form.reminderLeadDays) }}

        {{ form_row(form.timezone, {'attr': {'data-timezone-target': 'field'}}) }}

        <div class="mb-6 text-right">
            <button type="button"
                    class="text-sm underline text-color-ter"
                    data-action="timezone#detect"
            >{{ 'settings.detect_timezone'|trans }}</button>
        </div>

        <div class="text-center">
            <twig:Button type="submit">{{ 'settings.save'|trans }}</twig:Button>
        </div>

        {{ form_end(form) }}
    </div>

</twig:ContentCenter>
{% endblock %}
