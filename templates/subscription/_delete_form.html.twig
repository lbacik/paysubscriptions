<form method="post" action="{{ path('app_subscription_delete', {'id': subscription.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ subscription.id) }}">
    <twig:Button styleType="secondary"><span class="span-underline">{{ 'delete'|trans }}</span></twig:Button>
</form>
