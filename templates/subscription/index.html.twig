{% extends 'base.html.twig' %}

{% block title %}Subscription index{% endblock %}

{% block body %}
    <h1>Subscription index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>FirstPayment</th>
                <th>Currency</th>
                <th>Monthly</th>
                <th>Yearly</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for subscription in subscriptions %}
            <tr>
                <td>{{ subscription.id }}</td>
                <td>{{ subscription.name }}</td>
                <td>{{ subscription.firstPayment ? subscription.firstPayment|date('Y-m-d') : '' }}</td>
                <td>{{ subscription.currency }}</td>
                <td>{{ subscription.monthly }}</td>
                <td>{{ subscription.yearly }}</td>
                <td>
                    <a href="{{ path('app_subscription_edit', {'id': subscription.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_subscription_new') }}">Create new</a>
{% endblock %}
