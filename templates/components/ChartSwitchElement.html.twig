{% props href, active = false %}

{% set active = active is defined ? active : false %}
{% set buttonClass = active
    ? 'bg-color-ter text-color-pri'
    : 'text-color-ter'
%}
{% set ledClass = active
    ? 'bg-green-400'
    : 'bg-gray-200'
%}

<div class="relative chart-switch-button group {{ buttonClass }}">
    <div class="absolute left-1 rounded-full w-3 h-3 {{ ledClass }}"></div>
    <a class="chart-switch-link" href="{{ href }}">{% block content %}{% endblock %}</a>
</div>
