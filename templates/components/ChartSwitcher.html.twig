{% props active = {'type': 'bar', 'withCalculated': false} %}

<div {{ attributes.defaults({ class: "flex flex-row space-x-2 justify-end"}) }}>
    <div>
        <div class="relative chart-switch-button grouped bg-color-ter text-color-pri">
            <div class="absolute left-1 rounded-full w-3 h-3 bg-green-400"></div>
            <a class="chart-switch-link" href="{{ path('app_dashboard') }}">by month</a>
        </div>
    </div>

    <div class="flex flex-col space-y-1">
        <div class="relative chart-switch-button text-color-ter">
            <div class="absolute left-1 rounded-full w-3 h-3 bg-gray-200"></div>
            <a class="chart-switch-link" href="{{ path('app_dashboard', {chartType: 'monthly'}) }}">per month</a>
        </div>
        <div class="relative chart-switch-button">
            <div class="absolute left-1 rounded-full w-3 h-3 border border-gray-200"></div>
            <a class="chart-switch-link chart-option" href="{{ path('app_dashboard', {chartType: 'monthly', withCalculated: true}) }}">with calculated</a>
        </div>
    </div>

    <div class="flex flex-col space-y-1">
        <div class="relative chart-switch-button">
            <div class="absolute left-1 rounded-full w-3 h-3 border border-gray-200"></div>
            <a class="chart-switch-link" href="{{ path('app_dashboard', {chartType: 'yearly'}) }}">per year</a>
        </div>
        <div class="relative chart-switch-button">
            <div class="absolute left-1 rounded-full w-3 h-3 border border-gray-200"></div>
            <a class="chart-switch-link chart-option" href="{{ path('app_dashboard', {chartType: 'yearly', withCalculated: true}) }}">with calculated</a>
        </div>

    </div>
</div>
