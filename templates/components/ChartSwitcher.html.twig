{% props active = {type: 'bar', withCalculated: false} %}

<div {{ attributes.defaults({ class: "flex flex-row space-x-2 justify-end"}) }}>
    <div>
        <twig:ChartSwitchElement
                href="{{ path('app_dashboard', {chartType: 'bar'}) }}"
                active="{{ active.type is not defined or active.type == 'bar' }}"
        >{{ "dashboard.switch.by_month"|trans }}</twig:ChartSwitchElement>
    </div>

    <div class="flex flex-col space-y-1">
        <twig:ChartSwitchElement
                href="{{ path('app_dashboard', {chartType: 'monthly'}) }}"
                active="{{ active.type == 'monthly' }}"
        >{{ "dashboard.switch.per_month"|trans }}</twig:ChartSwitchElement>
        <twig:ChartSwitchElement
                href="{{ path('app_dashboard', {chartType: 'monthly', withCalculated: true}) }}"
                active="{{ active.type == 'monthly' and active.withCalculated }}"
        >{{ "dashboard.switch.with_calculated"|trans }}</twig:ChartSwitchElement>
    </div>

    <div class="flex flex-col space-y-1">
        <twig:ChartSwitchElement
                href="{{ path('app_dashboard', {chartType: 'yearly'}) }}"
                active="{{ active.type == 'yearly' }}"
        >{{ "dashboard.switch.per_year"|trans }}</twig:ChartSwitchElement>
        <twig:ChartSwitchElement
                href="{{ path('app_dashboard', {chartType: 'yearly', withCalculated: true}) }}"
                active="{{ active.type == 'yearly' and active.withCalculated }}"
        >{{ "dashboard.switch.with_calculated"|trans }}</twig:ChartSwitchElement>

    </div>
</div>
