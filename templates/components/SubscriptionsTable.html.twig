<div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
    <form method="get" action="{{ path('app_dashboard') }}" class="flex items-center gap-2">
        <input type="hidden" name="sort" value="{{ this.sort }}">
        <input type="hidden" name="order" value="{{ this.order }}">
        <label for="category-filter" class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Category</label>
        <select name="category"
                id="category-filter"
                onchange="this.form.submit()"
                class="text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-xl px-3 py-2 shadow-2xs focus:outline-none focus:ring-2 focus:ring-slate-300 cursor-pointer">
            {% set selectedCategoryId = this.selectedCategoryId %}
            <option value="all" {% if selectedCategoryId is null %}selected{% endif %}>All categories</option>
            {% for category in this.categories %}
                <option value="{{ category.id }}" {% if this.isCategorySelected(selectedCategoryId, category) %}selected{% endif %}>{{ category.name }}</option>
            {% endfor %}
        </select>
        <noscript>
            <button type="submit" class="btn-secondary text-xs py-2 px-3">Filter</button>
        </noscript>
    </form>
    {% if this.selectedCategoryId %}
        <a href="{{ path('app_dashboard', {sort: this.sort, order: this.order, category: 'all'}) }}"
           class="text-xs font-semibold text-slate-500 hover:text-slate-900 underline transition-colors">
            Clear filter
        </a>
    {% endif %}
</div>

<div class="overflow-x-auto">
    <table id="subscriptions-table" class="w-full text-left text-sm">
        <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-600 uppercase tracking-wider">
            <th scope="col" class="py-3 px-4 w-12 text-slate-400">#</th>
            <th scope="col" class="py-3 px-4">
                <twig:SortableColumn field="name">Subscription</twig:SortableColumn>
            </th>
            <th scope="col" class="py-3 px-4">Category</th>
            <th scope="col" class="py-3 px-4 text-end">
                <twig:SortableColumn field="price" title="Sort by comparable price in your main currency">Monthly</twig:SortableColumn>
            </th>
            <th scope="col" class="py-3 px-4 text-end">
                <twig:SortableColumn field="price" title="Sort by comparable price in your main currency">Yearly</twig:SortableColumn>
            </th>
            <th scope="col" class="py-3 px-4 text-end">
                <twig:SortableColumn field="renewal">Next renewal</twig:SortableColumn>
            </th>
            <th scope="col" class="py-3 px-4 text-end md:w-48">Actions</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">

        {% for subscription in this.subscriptions %}
            {{ include('dashboard/_row.html.twig', {subscription: subscription, mainCurrency: this.mainCurrency}) }}
        {% else %}
            <tr>
                <td colspan="7" class="py-10 px-4 text-center">
                    <p class="text-sm font-bold text-slate-900">No subscriptions found.</p>
                    {% if this.selectedCategoryId %}
                        <p class="mt-1 text-xs text-slate-500">No subscriptions match this category filter.</p>
                        <a href="{{ path('app_dashboard', {sort: this.sort, order: this.order, category: 'all'}) }}"
                           class="mt-3 inline-flex items-center btn-secondary text-xs py-2 px-4">
                            Clear filter
                        </a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}

        </tbody>
        <tfoot>

        {% set total = this.total %}

        <tr class="bg-slate-50/80 border-t-2 border-slate-200 text-slate-900">
            <td></td>
            <td class="py-4 px-4 font-bold">
                <div>Total{% if total.currency %} ({{ total.currency }}){% endif %}</div>
                <div class="text-xs text-slate-500 font-normal">incl. normalized equivalents</div>
                {% if total.pendingReview > 0 %}
                    <div class="text-xs text-amber-600 font-medium mt-1">{{ 'subscription.totals_exclude_review'|trans({'%count%': total.pendingReview}) }}</div>
                {% endif %}
            </td>
            <td></td>
            <td class="py-4 px-4 font-bold text-end">
                <div class="text-base text-slate-900">
                    {{ total.monthlyCalculated|number_format(2, '.', ' ') }}
                </div>
                <div class="text-xs text-slate-500 font-normal">
                    ({{ total.monthly|number_format(2, '.', ' ') }} direct)
                </div>
            </td>
            <td class="py-4 px-4 font-bold text-end">
                <div class="text-base text-slate-900">
                    {{ total.yearlyCalculated|number_format(2, '.', ' ') }}
                </div>
                <div class="text-xs text-slate-500 font-normal">
                    ({{ total.yearly|number_format(2, '.', ' ') }} direct)
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        </tfoot>
    </table>
</div>
