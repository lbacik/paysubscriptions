<div class="overflow-x-auto">
    <table id="subscriptions-table" class="w-full text-left text-sm">
        <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-600 uppercase tracking-wider">
            <th scope="col" class="py-3 px-4 w-12 text-slate-400">#</th>
            <th scope="col" class="py-3 px-4">
                <twig:SortableColumn field="name">Subscription</twig:SortableColumn>
            </th>
            <th scope="col" class="py-3 px-4 text-end">
                <twig:SortableColumn field="monthly">Monthly</twig:SortableColumn>
            </th>
            <th scope="col" class="py-3 px-4 text-end">
                <twig:SortableColumn field="yearly">Yearly</twig:SortableColumn>
            </th>
            <th scope="col" class="py-3 px-4 text-end md:w-48">Actions</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">

        {% for subscription in this.subscriptions %}
            {{ include('dashboard/_row.html.twig', {subscription: subscription}) }}
        {% endfor %}

        </tbody>
        <tfoot>

        {% set total = this.total %}

        <tr class="bg-slate-50/80 border-t-2 border-slate-200 text-slate-900">
            <td></td>
            <td class="py-4 px-4 font-bold">
                <div>Total</div>
                <div class="text-xs text-slate-500 font-normal">incl. normalized equivalents</div>
            </td>
            <td class="py-4 px-4 font-bold text-end">
                <div class="text-base text-slate-900">
                    {{ total.monthlyCalculated|number_format(2, '.', ' ') }}
                </div>
                <div class="text-xs text-slate-500 font-normal">
                    ({{ total.monthly|number_format(2, '.', ' ') }} direct)
                </div>
            </td>
            <td class="py-4 px-4 font-bold text-end">
                <div class="text-base text-slate-900">
                    {{ total.yearlyCalculated|number_format(2, '.', ' ') }}
                </div>
                <div class="text-xs text-slate-500 font-normal">
                    ({{ total.yearly|number_format(2, '.', ' ') }} direct)
                </div>
            </td>
            <td></td>
        </tr>
        </tfoot>
    </table>
</div>
