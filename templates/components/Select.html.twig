{% props options = [], selected = 0, url = null %}

{% set targetUrl = url ? url : path('app_dashboard', {chartType: 'monthly'}) %}

<div{{ attributes }}>
    <div data-controller="select-month" data-select-month-url-value="{{ targetUrl }}">
        <div class="relative">
            <button type="button"
                    class="relative inline-flex items-center justify-between gap-2 rounded-xl bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs border border-slate-200 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 transition-all cursor-pointer min-w-28"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    data-action="select-month#click"
            >
                <span class="flex items-center truncate capitalize">
                    {{ options[selected]|default(options[0]|default('')) }}
                </span>
                <span class="pointer-events-none flex items-center text-slate-400">
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd"
                              d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z"
                              clip-rule="evenodd"/>
                    </svg>
                </span>
            </button>

            <ul
                    data-select-month-target="options"
                    class="hidden absolute z-30 mt-1 max-h-56 min-w-36 overflow-auto rounded-xl bg-white py-1 text-xs shadow-lg border border-slate-200 focus:outline-none"
                    tabindex="-1"
                    role="listbox"
            >
                {% for option in options %}
                    <li class="relative cursor-pointer select-none py-2 px-3 text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition-colors {% if loop.index0 == selected %}font-semibold bg-slate-50 text-color-ter{% endif %}"
                        role="option"
                        value="{{ loop.index0 }}"
                        data-action="click->select-month#select"
                    >
                        <div class="flex items-center justify-between">
                            <span class="block truncate capitalize">{{ option }}</span>
                            {% if loop.index0 == selected %}
                                <i class="fa-solid fa-check text-xs text-color-ter ml-2"></i>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

</div>
