{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans }} — {{ 'service.name'|trans }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-6">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
            {{ 'profile.title'|trans }}
        </h1>
        <p class="text-sm text-slate-500 mt-1">
            {{ app.user.email }}
        </p>
    </div>

    {% if isFirstConfirmation %}
        <div class="p-4 rounded-2xl bg-blue-50 border border-blue-200/80 flex items-center gap-2 text-sm text-blue-900">
            <i class="fa-solid fa-circle-info text-blue-500"></i>
            <span>{{ 'profile.first_confirmation_hint'|trans }}</span>
        </div>
    {% endif %}

    <div class="bg-white rounded-3xl p-6 md:p-8 border border-slate-200/80 shadow-xs">
        <div class="form">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.mainCurrency) }}
            <div class="flex flex-row items-center justify-end space-x-2 pt-5">
                <twig:Button styleType="secondary" href="{{ path('app_dashboard') }}">{{ 'cancel'|trans }}</twig:Button>
                <twig:Button>{{ 'profile.save'|trans }}</twig:Button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
