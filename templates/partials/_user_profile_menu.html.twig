<div
        data-controller="user-menu"
>
    <button type="button"
            class="flex text-sm bg-color-sec rounded-full md:me-0 focus:ring-4 focus:ring-gray-300"
            id="user-menu-button" aria-expanded="false" data-dropdown-toggle="user-dropdown"
            data-dropdown-placement="bottom"
            data-action="user-menu#toggle"
    >
        <span class="sr-only">Open user menu</span>
        <span class="flex w-16 h-16 items-center justify-center rounded-full bg-color-sec text-2xl font-bold text-white" aria-hidden="true">{{ app.user.email|first|upper }}</span>
    </button>

    <!-- Dropdown menu -->
    <div class="absolute z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded-lg shadow"
         id="user-dropdown"
         data-user-menu-target="menu"
    >
        <div class="px-4 py-3">
            <span class="block text-sm text-gray-500 truncate">{{ app.user.email }}</span>
        </div>
        <ul class="py-2" aria-labelledby="user-menu-button">
            <twig:UserMenuElement href="{{ path('app_settings') }}">{{ 'user.settings'|trans }}</twig:UserMenuElement>
            <twig:UserMenuElement href="{{ path('app_account_delete') }}">{{ 'account.delete_menu'|trans }}</twig:UserMenuElement>
            <twig:UserMenuElement href="{{ path('app_logout') }}">{{ 'user.logout'|trans }}</twig:UserMenuElement>
        </ul>
    </div>
</div>
