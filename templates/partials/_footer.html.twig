<footer class="py-10">
    <div class="container mx-auto px-4">
        <div class="flex flex-col justify-between items-center">

            <div class="w-full md:w-3/4 m-auto border-t-2 border-color-sec border-double mb-16"></div>

            <div class="flex flex-col md:flex-row space-y-2 md:space-y-0 md:space-x-4 items-center w-full lg:w-2/3 justify-center">

                <!-- Newsletter Subscription Form -->
                <div class="w-full {% if app.request.attributes.get('_route') != 'app_pricing' %} md:w-4/5 h-fit {% else %} md:w-2/3 min-w-[500px] {% endif %} bg-color-sec px-8 pt-6 pb-6 rounded-xl">
                    <div class="w-full">
                        <h2 class="text-lg font-semibold mb-4">Subscribe to Newsletter</h2>
                        <form name="newsletter" action="{{ path('app_newsletter_subscribe') }}" method="POST">
                            <div class="flex flex-col md:flex-row">
                                <input type="email"
                                       name="email"
                                       placeholder="Enter your email"
                                       class="p-2 rounded-md mb-2 md:mb-0 md:mr-2 flex-1"
                                />
                                <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}"/>
                                <twig:Button type="submit" class="w-auto">Subscribe</twig:Button>
                            </div>
                        </form>
                        <div class="mt-4 text-xs text-color-qua">As for the time being all subscriptions will be added to the <a class="font-bold underline" href="https://gprodb.com">gprodb.com</a> newsletter</div>
                    </div>
                </div>

                {% if app.request.attributes.get('_route') != 'app_pricing' %}
                    <div class="flex flex-col mx-auto w-fit text-center bg-green-50 px-5 py-5 font-handwriting2">
                        <span class="font-bold bg-green-100 py-1 font-sans">Enjoying PaySubscriptions?</span>
                        <div class="my-5 flex items-center justify-center">
                            <a href="https://www.buymeacoffee.com/lbacik" target="_blank"><img
                                        src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
                                        alt="Buy Me A Coffee" style="height: 60px !important;width: 217px !important;"></a>
                        </div>
                        Thank you for your support and for using PaySubscriptions!
                    </div>
                {% endif %}
            </div>

        </div>
        <!-- Footer Bottom -->
        <div class="text-center mt-10">
            <p class="text-gray-400 text-sm">&copy; 2024 PaySubscriptions. All rights reserved.</p>
        </div>
    </div>
</footer>
