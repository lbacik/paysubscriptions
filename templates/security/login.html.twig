{% extends 'base.html.twig' %}

{% block body %}
    <twig:ContentCenter width="w-full md:w-1/3 px-10 my-20">

        {# Rendered outside the login form on purpose: the unverified-account
           message carries its own inline resend form, and nested forms are
           invalid HTML (the inner one would submit to /login instead). #}
        {% if error %}
            <div class="text-red-600 mb-6" role="alert">{{ error.messageKey|trans(error.messageData, 'security')|raw }}</div>
        {% endif %}

        <form method="post">
            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}

            <h1 class="mb-10 font-thin text-lg text-color-qua text-right border-b border-color-sec">{{ 'user.please_login'|trans }}</h1>

            <div class="space-y-6">
                <div>
                    <label for="inputEmail"
                           class="text-sm text-color-ter"
                    >{{ 'user.email'|trans }}</label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="inputEmail"
                           class="w-full px-3 py-2 rounded-lg border border-color-sec"
                           autocomplete="email"
                           required
                           autofocus
                    >
                </div>
                <div>
                    <div>
                        <label for="inputPassword"
                               class="text-sm text-color-ter"
                        >{{ 'user.password'|trans }}</label>
                        <input type="password"
                               name="password"
                               id="inputPassword"
                               class="w-full px-3 py-2 rounded-lg border border-color-sec"
                               autocomplete="current-password"
                               required
                        >
                    </div>
                    <div class="w-full text-end">
                        <a href="{{ path('app_forgot_password_request') }}" class="text-green-700 text-sm">{{ 'user.forgot_password'|trans }}</a>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token"
                       value="{{ csrf_token('authenticate') }}"
                >

                <div>
                    <label for="rememberMe" class="text-color-ter">
                        <input type="checkbox" name="_remember_me" id="rememberMe" class="p-2 mr-2"> {{ 'user.remember_me'|trans }}
                    </label>
                </div>
                <div class="text-center">
                    <twig:Button class="btn" type="submit">{{ 'user.login'|trans }}</twig:Button>
                </div>
            </div>
        </form>

        <div class="mt-10 border-t border-color-sec pt-6">
            <p class="text-sm text-color-ter mb-3">{{ 'user.no_activation_email'|trans }}</p>
            <form method="post" action="{{ path('resend_activation') }}" class="space-y-3">
                <div>
                    <label for="resendEmail"
                           class="text-sm text-color-ter"
                    >{{ 'user.email'|trans }}</label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="resendEmail"
                           class="w-full px-3 py-2 rounded-lg border border-color-sec"
                           autocomplete="email"
                           required
                    >
                </div>

                <input type="hidden" name="_token"
                       value="{{ csrf_token('resend_activation') }}"
                >

                <div class="text-center">
                    <twig:Button class="btn-secondary" type="submit">{{ 'user.resend_activation'|trans }}</twig:Button>
                </div>
            </form>
        </div>
    </twig:ContentCenter>
{% endblock %}
