{% extends 'base.html.twig' %}

{% block body %}
    <twig:ContentCenter class="my-20" width="w-4/5 lg:w-2/5">
        <div>
            <h1 class="text-color-qua text-2xl font-bold">Contact Us</h1>
            <p class="text-color-ter px-5 py-10 text-center">We are here to help you. Please fill out the form below and we will get back to you as soon as possible.</p>
        </div>
        <div class="form">
            {{ form_start(form) }}
            <div class="md:columns-2 space-y-4 md:space-y-0">
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
            </div>
            {{ form_row(form.subject) }}
            {{ form_row(form.message) }}

            <div class="text-center">
                <twig:Button type="submit" class="w-full md:w-auto">Send Message</twig:Button>
            </div>

            {{ form_end(form) }}
        </div>
    </twig:ContentCenter>
{% endblock %}
