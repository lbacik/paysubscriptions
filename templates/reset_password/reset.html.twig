{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    <twig:ContentCenter width="w-full md:w-1/3 px-10 my-20">
        <div class="form">
            <h1>Reset your password</h1>

            {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword) }}

            <div class="text-center">
                <twig:Button type="submit">Reset password</twig:Button>
            </div>

            {{ form_end(resetForm) }}
        </div>
    </twig:ContentCenter>
{% endblock %}
