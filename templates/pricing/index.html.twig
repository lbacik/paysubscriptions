{% extends 'base.html.twig' %}

{% block title %}Pricing — PaySubscriptions{% endblock %}

{% block metaheaders %}
    <meta name="description" content="PaySubscriptions is free for up to {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions per account. Track monthly and yearly costs with no payment card required.">
{% endblock %}

{% block body %}
<div class="relative overflow-hidden py-12 md:py-20">
    <!-- Subtle gradient background highlight -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-blue-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Header -->
        <div class="text-center max-w-2xl mx-auto">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-4">
                <i class="fa-solid fa-tag text-color-ter"></i>
                Transparent &amp; Free
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
                A clear view of your subscriptions. <span class="text-color-ter">For free.</span>
            </h1>
            <p class="mt-4 text-lg text-slate-600">
                Track personal and household recurring costs with no credit card, no subscription fees, and no surprise charges.
            </p>
        </div>

        <!-- Featured Pricing Card -->
        <div class="mt-12 max-w-lg mx-auto bg-white rounded-3xl border border-slate-200/90 shadow-xl overflow-hidden">
            <div class="p-8 sm:p-10">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Free Plan</h2>
                        <p class="text-sm text-slate-500 mt-1">For individuals and households</p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 uppercase tracking-wide">
                        Available Today
                    </span>
                </div>

                <div class="mt-6 flex items-baseline">
                    <span class="text-5xl font-extrabold text-slate-900">$0</span>
                    <span class="ml-2 text-slate-500 font-medium">/ free forever</span>
                </div>

                <p class="mt-4 text-sm text-slate-600 leading-relaxed">
                    Add, edit, and organize up to {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions, compare equivalents, and view charts.
                </p>

                <div class="mt-8">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}" class="btn-cta w-full text-center">
                            View your subscriptions
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="btn-cta w-full text-center">
                            Create your free account
                            <i class="fa-solid fa-arrow-right ml-2 text-sm"></i>
                        </a>
                    {% endif %}
                </div>

                <!-- Included Features -->
                <div class="mt-8 pt-8 border-t border-slate-100">
                    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4">Everything included:</h3>
                    <ul class="space-y-3.5 text-sm text-slate-700">
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-emerald-600 mt-1 mr-3 shrink-0"></i>
                            <span>Track up to <strong>{{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions</strong> per account</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-emerald-600 mt-1 mr-3 shrink-0"></i>
                            <span>Automatic <strong>monthly &amp; yearly cost equivalents</strong></span>
                        </li>
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-emerald-600 mt-1 mr-3 shrink-0"></i>
                            <span>Interactive cost breakdown charts</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-emerald-600 mt-1 mr-3 shrink-0"></i>
                            <span><strong>No bank credentials</strong> required — you enter everything yourself</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-emerald-600 mt-1 mr-3 shrink-0"></i>
                            <span>No payment card needed — never charged</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- FAQ Grid -->
        <div class="mt-20">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Frequently Asked Questions</h2>
                <p class="mt-2 text-slate-600 text-sm">Honest answers to common questions about PaySubscriptions.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Question 1 -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
                    <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-credit-card text-color-ter"></i>
                        Do I need to provide a payment card?
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        No. You will never be asked for credit card details. Creating an account and using the service up to the limit is completely free.
                    </p>
                </div>

                <!-- Question 2 -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
                    <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-building-columns text-emerald-600"></i>
                        Does PaySubscriptions connect to my bank?
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        No. We do not connect to bank accounts or automatically import transactions. You enter subscription details yourself — nothing is imported or connected.
                    </p>
                </div>

                <!-- Question 3 -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
                    <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-indigo-500"></i>
                        What if I need more than {{ constant('App\\Entity\\Limits::DEFAULT_SUBSCRIPTIONS_LIMIT') }} subscriptions?
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        There is currently no paid tier or higher limit plan available. If you need more entries, please <a href="{{ path('app_contact') }}" class="text-color-ter font-semibold underline">tell us what you need</a> so we can consider it for future updates.
                    </p>
                </div>

                <!-- Question 4 -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
                    <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-bell text-amber-500"></i>
                        Are renewal reminders available?
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Not yet. Upcoming renewals and optional email reminders are
                        <span class="inline-block px-2 py-0.5 rounded-full bg-orange-100 text-orange-800 text-xs font-bold whitespace-nowrap">Planned for v1.0</span>.
                        <a href="{{ path('app_docs') }}" class="text-color-ter font-semibold underline">See what is available today vs. what is planned</a>.
                    </p>
                </div>

                <!-- Question 5 -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
                    <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-coins text-emerald-600"></i>
                        How are different currencies handled?
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Totals are shown in your main currency. Each subscription keeps its own currency,
                        and when they differ you enter the converted amount yourself — there is no automatic conversion.
                    </p>
                </div>

                <!-- Question 6 -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
                    <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-user-shield text-purple-600"></i>
                        Can I delete my account or get a copy of my data?
                    </h3>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Self-service account deletion and manual-request data export are planned for v1.0 —
                        there is no self-service download.
                        <a href="{{ path('app_privacy') }}" class="text-color-ter font-semibold underline">See how deletion and export work</a>.
                    </p>
                </div>
            </div>
        </div>

        <!-- Optional Support (Buy Me a Coffee) -->
        <div class="mt-16 bg-white rounded-2xl border border-slate-200/80 p-8 text-center max-w-xl mx-auto shadow-xs">
            <span class="text-xs font-bold text-color-ter uppercase tracking-wider">Project Independence</span>
            <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">Want to support the project?</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
                PaySubscriptions is independently maintained. Voluntary contributions help cover hosting and domain costs. They are completely optional and do not change your account limits.
            </p>
            <div class="flex items-center justify-center">
                <a href="https://www.buymeacoffee.com/lbacik" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-[#FFDD00] px-6 py-3 text-base font-bold text-slate-900 shadow-sm transition-transform duration-200 hover:scale-105">
                    <i class="fa-solid fa-mug-saucer" aria-hidden="true"></i>
                    <span>Buy Me A Coffee</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
