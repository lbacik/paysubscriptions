{% extends 'base.html.twig' %}

{% block body %}

    <div class="flex flex-col w-4/5 md:w-1/2 mx-auto mt-20 mb-10 font-handwriting2 text-xl text-color-qua space-y-10">
        <p>
            <span class="px-3 bg-yellow-100 font-bold">Enjoy the Service for Free</span>
            For now, take advantage of PaySubscriptions’ comprehensive free plan and manage your subscriptions effortlessly!
        </p>

        <div class="mx-10 px-10 py-5 rounded-xl bg-purple-200 font-handwriting text-2xl text-color-ter">
            <span class="font-bold">Subscription Limit</span>: The free plan allows you to add up to 30 subscriptions to your account.
        </div>

        <p class="font-handwriting2">
            If you find that you need to manage more than 30 subscriptions, <span class="font-bold px-2 bg-red-200">stay tuned!</span>
        </p>

        <div class="flex flex-col mx-auto w-fit text-center border border-green-400 rounded-xl bg-green-50 px-5 py-5">
            <span class="font-bold bg-green-100 py-1">Enjoying PaySubscriptions?</span>
            <div class="my-5 flex items-center justify-center">
                <a href="https://www.buymeacoffee.com/lbacik" target="_blank"><img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me A Coffee" style="height: 60px !important;width: 217px !important;" ></a>
            </div>
            Thank you for your support and for using PaySubscriptions!
        </div>
    </div>

{% endblock %}
