{% extends 'base.html.twig' %}

{% block title %}{{ 'category.title'|trans }} — {{ 'service.name'|trans }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-8">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                {{ 'category.title'|trans }}
            </h1>
            <p class="text-sm text-slate-500 mt-1">
                {{ 'category.subtitle'|trans }}
            </p>
        </div>

        <div class="flex items-center gap-2">
            <a href="{{ path('app_dashboard') }}"
               class="btn-secondary text-xs py-2 px-4 inline-flex items-center gap-2">
                <i class="fa-solid fa-arrow-left text-xs"></i>
                <span>{{ 'dashboard.title'|trans }}</span>
            </a>
            <a href="{{ path('app_category_new') }}"
               class="btn-primary text-xs py-2 px-4 inline-flex items-center gap-2 shadow-xs hover:shadow transition-all">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>{{ 'category.new'|trans }}</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-2xs overflow-hidden">
        {% if categories is empty %}
            <p class="p-6 text-sm text-slate-500">{{ 'category.empty'|trans }}</p>
        {% else %}
            <ul class="divide-y divide-slate-100">
                {% for category in categories %}
                    <li class="flex items-center justify-between gap-4 py-3.5 px-5 hover:bg-slate-50/90 transition-colors">
                        <div class="flex items-center gap-3 min-w-0">
                            <span class="inline-block w-4 h-4 rounded-full border border-slate-200 shrink-0"
                                  style="background-color: {{ category.color }}"
                                  title="{{ category.color }}"></span>
                            <span class="font-semibold text-slate-900 truncate">{{ category.name }}</span>
                            <span class="text-xs text-slate-400">
                                {{ 'category.usage_count'|trans({'%count%': category.subscriptions|length}) }}
                            </span>
                        </div>
                        <div class="inline-flex items-center gap-1.5 shrink-0">
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                               class="inline-flex items-center px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg shadow-2xs transition-all">
                                <i class="fa-solid fa-pen text-[10px] mr-1.5 text-slate-400"></i>
                                {{ 'edit'|trans }}
                            </a>
                            <a href="{{ path('app_category_delete', {'id': category.id}) }}"
                               class="inline-flex items-center px-2.5 py-1 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-white border border-rose-200/80 hover:bg-rose-50 rounded-lg shadow-2xs transition-all">
                                <i class="fa-solid fa-trash text-[10px] mr-1.5 text-rose-400"></i>
                                {{ 'delete'|trans }}
                            </a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

</div>
{% endblock %}
