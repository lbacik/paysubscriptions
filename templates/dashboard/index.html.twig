{% extends 'base.html.twig' %}

{% block title %}{{ "dashboard.title"|trans }} — {{ "service.name"|trans }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-8">

    <!-- Dashboard Header -->
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
            {{ "dashboard.title"|trans }}
        </h1>
        <p class="text-sm text-slate-500 mt-1">
            {{ "dashboard.subtitle"|trans }}
            {% if mainCurrency %}<span class="font-semibold text-slate-600">{{ mainCurrency }}</span>{% endif %}
        </p>
    </div>

    {% if not mainCurrency %}
        <div class="p-4 rounded-2xl bg-blue-50 border border-blue-200/80 flex flex-col sm:flex-row sm:items-center gap-3 text-sm text-blue-900">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-blue-500"></i>
                <span>{{ "dashboard.currency_confirm_prompt"|trans }}</span>
            </div>
            <a href="{{ path('app_profile') }}"
               class="btn-primary text-xs py-2 px-4 inline-flex items-center gap-2 shrink-0">
                <i class="fa-solid fa-coins text-xs"></i>
                <span>{{ "dashboard.currency_confirm_cta"|trans }}</span>
            </a>
        </div>
    {% endif %}

    {% if pendingReviewSubscriptions|length > 0 %}
        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200/80 text-sm text-amber-800 space-y-2">
            <div class="flex items-center gap-2 font-semibold">
                <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
                <span>{{ "dashboard.stale_review_title"|trans({'%count%': pendingReviewSubscriptions|length, '%currency%': mainCurrency}) }}</span>
            </div>
            <p class="text-xs">{{ "dashboard.stale_review_hint"|trans }}</p>
            <ul class="text-xs space-y-1">
                {% for pending in pendingReviewSubscriptions %}
                    <li>
                        <a href="{{ path('app_subscription_edit', {'id': pending.id}) }}"
                           data-turbo-frame="modal"
                           class="font-semibold underline hover:text-amber-900 transition-colors">
                            {{ pending.name }} ({{ pending.currency }} → {{ mainCurrency }})
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <!-- Summary KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Monthly Spending Card -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-2xs hover:shadow-xs transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">{{ "dashboard.kpi.monthly_title"|trans }}</span>
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-color-ter flex items-center justify-center text-sm">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-3xl font-extrabold text-slate-900 tracking-tight">
                    {{ totals.monthlyCalculated|number_format(2, '.', ' ') }}
                    <span class="text-sm font-normal text-slate-500">{% if totals.currency %}{{ totals.currency }} {% endif %}/ mo</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="inline-flex items-center gap-1 font-medium text-slate-700">
                        {{ totals.monthly|number_format(2, '.', ' ') }}
                    </span>
                    <span class="text-slate-500">{{ "dashboard.kpi.monthly_direct"|trans }}</span>
                    {% set monthlyFromYearly = totals.monthlyCalculated - totals.monthly %}
                    {% if monthlyFromYearly > 0.01 %}
                        <span class="text-slate-500" aria-hidden="true">•</span>
                        <span class="text-slate-500">+{{ monthlyFromYearly|number_format(2, '.', ' ') }} {{ "dashboard.kpi.monthly_normalized"|trans }}</span>
                    {% endif %}
                </div>
                <div class="mt-1.5 text-[11px] text-slate-400">
                    {% if totals.currency %}
                        {{ "dashboard.kpi.monthly_equivalent_caption"|trans({'%currency%': totals.currency}) }}
                    {% else %}
                        {{ "dashboard.kpi.no_currency_note"|trans }}
                    {% endif %}
                    {% if totals.pendingReview > 0 %}
                        <span class="text-amber-600 font-medium">· {{ 'subscription.totals_exclude_review'|trans({'%count%': totals.pendingReview}) }}</span>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Yearly Spending Card -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-2xs hover:shadow-xs transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">{{ "dashboard.kpi.yearly_title"|trans }}</span>
                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-3xl font-extrabold text-slate-900 tracking-tight">
                    {{ totals.yearlyCalculated|number_format(2, '.', ' ') }}
                    <span class="text-sm font-normal text-slate-500">{% if totals.currency %}{{ totals.currency }} {% endif %}/ yr</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="inline-flex items-center gap-1 font-medium text-slate-700">
                        {{ totals.yearly|number_format(2, '.', ' ') }}
                    </span>
                    <span class="text-slate-500">{{ "dashboard.kpi.yearly_direct"|trans }}</span>
                    {% set yearlyFromMonthly = totals.yearlyCalculated - totals.yearly %}
                    {% if yearlyFromMonthly > 0.01 %}
                        <span class="text-slate-500" aria-hidden="true">•</span>
                        <span class="text-slate-500">+{{ yearlyFromMonthly|number_format(2, '.', ' ') }} {{ "dashboard.kpi.yearly_normalized"|trans }}</span>
                    {% endif %}
                </div>
                <div class="mt-1.5 text-[11px] text-slate-400">
                    {% if totals.currency %}
                        {{ "dashboard.kpi.yearly_equivalent_caption"|trans({'%currency%': totals.currency}) }}
                    {% else %}
                        {{ "dashboard.kpi.no_currency_note"|trans }}
                    {% endif %}
                    {% if totals.pendingReview > 0 %}
                        <span class="text-amber-600 font-medium">· {{ 'subscription.totals_exclude_review'|trans({'%count%': totals.pendingReview}) }}</span>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Subscriptions Count / Limits Card -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-2xs hover:shadow-xs transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">{{ "dashboard.kpi.limit_title"|trans }}</span>
                <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-receipt"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-3xl font-extrabold text-slate-900 tracking-tight">
                    {{ totalSubscriptionCount }}
                    <span class="text-sm font-normal text-slate-500">/ {{ subscriptionLimit }}</span>
                </div>
                <div class="mt-3">
                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                        <div class="h-full rounded-full transition-all duration-500 {% if limitPercentage >= 100 %}bg-red-500{% elseif limitPercentage >= 80 %}bg-amber-500{% else %}bg-emerald-500{% endif %}"
                             style="width: {{ limitPercentage }}%"></div>
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-[11px] text-slate-500">
                        <span>{{ "dashboard.kpi.slots_used"|trans({'%count%': totalSubscriptionCount, '%limit%': subscriptionLimit}) }}</span>
                        {% if addSubscriptionDisabled %}
                            <span class="text-red-600 font-semibold">{{ "subscription.limit_reached"|trans }}</span>
                        {% else %}
                            <span class="text-emerald-700 font-medium">{{ subscriptionLimit - totalSubscriptionCount }} remaining</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Renewals Widget -->
    {{ include('dashboard/_upcoming_renewals.html.twig') }}

    <!-- Chart Section Card -->
    {% if subscriptions|length > 0 %}
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs p-6 md:p-8">
            <turbo-frame id="chart">
                {% set isBarActive = active.type is not defined or active.type == 'bar' %}
                <div {% if isBarActive %}data-controller="chart-legend"{% endif %} class="relative">
                    <twig:ChartSwitcher :active="active" :subscriptionsCount="subscriptions|length"/>

                    <p class="mt-4 text-xs text-slate-500">
                        {% if chartMeta.currency %}
                            {{ ("dashboard.chart.caption_" ~ chartMeta.basis)|trans({'%currency%': chartMeta.currency}) }}
                        {% else %}
                            {{ "dashboard.chart.no_currency_note"|trans }}
                        {% endif %}
                    </p>
                    {% if chartMeta.hiddenCount > 0 and chartMeta.hiddenCycle == 'yearly' %}
                        <p class="mt-1 text-xs text-slate-500">
                            <i class="fa-solid fa-circle-info text-slate-400"></i>
                            {{ "dashboard.chart.filtered_yearly"|trans({'%count%': chartMeta.hiddenCount}) }}
                        </p>
                    {% elseif chartMeta.hiddenCount > 0 and chartMeta.hiddenCycle == 'monthly' %}
                        <p class="mt-1 text-xs text-slate-500">
                            <i class="fa-solid fa-circle-info text-slate-400"></i>
                            {{ "dashboard.chart.filtered_monthly"|trans({'%count%': chartMeta.hiddenCount}) }}
                        </p>
                    {% endif %}
                    {% if chartMeta.empty %}
                        <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50/60 p-6 text-center">
                            <div class="mx-auto w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center text-sm shadow-2xs">
                                <i class="fa-solid fa-chart-pie"></i>
                            </div>
                            <p class="mt-3 text-sm font-bold text-slate-900">
                                {{ "dashboard.chart.empty_title"|trans }}
                            </p>
                            <p class="mt-1 text-xs text-slate-500">
                                {{ "dashboard.chart.empty_body"|trans }}
                                {% if chartMeta.hiddenCount > 0 and chartMeta.basis == 'monthly_direct' %}
                                    {{ "dashboard.chart.empty_hint_monthly"|trans }}
                                {% elseif chartMeta.hiddenCount > 0 and chartMeta.basis == 'yearly_direct' %}
                                    {{ "dashboard.chart.empty_hint_yearly"|trans }}
                                {% endif %}
                            </p>
                        </div>
                    {% endif %}

                    <div class="relative mt-6 overflow-hidden rounded-2xl">
                        <div id="chart-container"
                             role="img"
                             aria-label="{{ 'dashboard.chart.summary'|trans }}"
                             class="mx-auto w-full {% if fullWidth %} h-[360px] md:h-[420px] {% else %} max-w-xl h-[340px] md:h-[380px] {% endif %} relative flex items-center justify-center">
                            {{ render_chart(chart, {
                                'data-controller': 'chart-click',
                                'data-chart-click-url-value': path('app_dashboard', { 'chartType': 'monthly' }),
                            } ) }}
                        </div>

                        {% if isBarActive %}
                            <!-- Sliding Legend Card -->
                            <div data-chart-legend-target="card"
                                 class="absolute inset-y-0 right-0 w-full sm:w-80 md:w-92 bg-white/95 backdrop-blur-md border-l border-slate-200/90 shadow-2xl flex flex-col z-20 transform transition-all duration-300 ease-in-out translate-x-full opacity-0 pointer-events-none rounded-r-2xl">

                                <!-- Header -->
                                <div class="p-3.5 sm:p-4 border-b border-slate-100 flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-xl bg-blue-50 text-color-ter flex items-center justify-center text-xs shadow-2xs">
                                            <i class="fa-solid fa-layer-group"></i>
                                        </div>
                                        <div>
                                            <h3 class="text-xs font-bold text-slate-900 tracking-tight">{{ "dashboard.legend.title"|trans }}</h3>
                                            <span data-chart-legend-target="countBadge" class="text-[11px] text-slate-500 font-medium"></span>
                                        </div>
                                    </div>
                                    <button type="button"
                                            data-action="click->chart-legend#close"
                                            class="w-7 h-7 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 flex items-center justify-center transition-colors cursor-pointer"
                                            title="{{ 'cancel'|trans }}"
                                            aria-label="{{ 'cancel'|trans }}">
                                        <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <!-- Toolbar: Search + Quick Select All/None -->
                                <div class="p-3 border-b border-slate-100 bg-slate-50/60 space-y-2">
                                    <div class="relative">
                                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-[11px] text-slate-400"></i>
                                        <input type="text"
                                               data-chart-legend-target="search"
                                               data-action="input->chart-legend#filter"
                                               placeholder="{{ 'dashboard.legend.search_placeholder'|trans }}"
                                               aria-label="{{ 'dashboard.legend.search_placeholder'|trans }}"
                                               class="w-full text-xs pl-8 pr-3 py-1.5 rounded-xl border border-slate-200 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                                    </div>
                                    <div class="flex items-center justify-between text-[11px] px-0.5">
                                        <span class="text-slate-500 font-medium">{{ "dashboard.legend.quick_actions"|trans }}</span>
                                        <div class="flex items-center gap-2">
                                            <button type="button"
                                                    data-action="click->chart-legend#showAll"
                                                    class="font-semibold text-blue-600 hover:text-blue-700 hover:underline cursor-pointer">
                                                {{ "dashboard.legend.show_all"|trans }}
                                            </button>
                                            <span class="text-slate-500" aria-hidden="true">•</span>
                                            <button type="button"
                                                    data-action="click->chart-legend#hideAll"
                                                    class="font-semibold text-slate-500 hover:text-slate-700 hover:underline cursor-pointer">
                                                {{ "dashboard.legend.hide_all"|trans }}
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Scrollable Items List -->
                                <div class="flex-1 overflow-y-auto p-2 space-y-1"
                                     data-chart-legend-target="list">
                                    <!-- Populated dynamically from Chart datasets -->
                                </div>

                                <!-- Empty Search State -->
                                <div data-chart-legend-target="emptyState" class="hidden p-6 text-center text-xs text-slate-500">
                                    <i class="fa-regular fa-folder-open text-base mb-1 block"></i>
                                    <span>{{ "dashboard.legend.no_results"|trans }}</span>
                                </div>

                                <!-- Footer Hint -->
                                <div class="p-3 border-t border-slate-100 bg-slate-50/50 text-[11px] text-slate-500 flex items-center gap-1.5">
                                    <i class="fa-regular fa-lightbulb text-amber-500 text-xs"></i>
                                    <span>{{ "dashboard.legend.hint"|trans }}</span>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </turbo-frame>
        </div>
    {% endif %}

    <!-- Subscriptions Table Card -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs p-6 md:p-8">
        {{ include('dashboard/_table.html.twig') }}
    </div>

</div>
{% endblock %}
