<tr class="hover:bg-slate-50/90 transition-colors group">
    <td class="py-3.5 px-4 text-xs text-slate-400 font-medium">{{ loop.index }}</td>
    <td class="py-3.5 px-4">
        <div class="font-semibold text-slate-900">
            {{ subscription.name }}
            {% if subscription.currency %}
                <span class="ml-1 inline-flex items-center px-1.5 py-0.5 text-[10px] font-bold text-slate-600 bg-slate-100 rounded-md" title="{{ 'subscription.currency_title'|trans }}">{{ subscription.currency }}</span>
            {% endif %}
        </div>
        {% if subscription.nextPayment %}
            <div class="text-xs text-slate-400 mt-0.5">
                Next payment: {{ next_renewal(subscription)|date('Y-m-d') }}
            </div>
        {% endif %}
        {% if subscription.notes %}
            <div class="text-xs text-slate-500 mt-0.5 break-words">
                {{ subscription.notes|length > 160 ? subscription.notes|slice(0, 160) ~ '…' : subscription.notes }}
            </div>
        {% endif %}
        {% if mainCurrency is defined and mainCurrency and subscription.needsConvertedReview(mainCurrency) %}
            <div class="text-xs text-amber-600 mt-0.5 font-medium">
                <i class="fa-solid fa-triangle-exclamation text-[10px]"></i>
                {{ 'subscription.converted_review_badge'|trans({'%old%': subscription.convertedCurrency, '%new%': mainCurrency}) }}
            </div>
        {% elseif mainCurrency is defined and mainCurrency and subscription.isPendingReview(mainCurrency) %}
            <div class="text-xs text-amber-600 mt-0.5 font-medium">
                <i class="fa-solid fa-triangle-exclamation text-[10px]"></i>
                {{ 'subscription.converted_missing_badge'|trans({'%currency%': subscription.currency, '%new%': mainCurrency}) }}
            </div>
        {% elseif subscription.currency and mainCurrency is defined and mainCurrency
            and subscription.currency != mainCurrency and subscription.hasConvertedAmount %}
            <div class="text-xs text-slate-400 mt-0.5">
                ≈ {{ subscription.convertedAmount|number_format(2, '.', ' ') }} {{ mainCurrency }} {{ 'subscription.converted_suffix'|trans }}
            </div>
        {% endif %}
    </td>
    <td class="py-3.5 px-4">
        {% if subscription.category %}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-slate-600 bg-slate-50 border border-slate-200 rounded-full whitespace-nowrap">
                <span class="inline-block w-2.5 h-2.5 rounded-full border border-slate-200"
                      style="background-color: {{ subscription.category.color }}"></span>
                {{ subscription.category.name }}
            </span>
        {% endif %}
    </td>
    <td class="py-3.5 px-4 text-end">
        {% if mainCurrency is defined and mainCurrency and subscription.isPendingReview(mainCurrency) %}
            <span class="text-slate-300 font-normal" title="{{ 'subscription.totals_exclude_review'|trans({'%count%': 1}) }}">—</span>
        {% elseif subscription.isMonthly() %}
            <span class="font-bold text-slate-900">{{ subscription.getReportingMonthlyCalculated(mainCurrency|default(null))|number_format(2, '.', ' ') }}</span>
        {% else %}
            <span class="text-xs text-slate-500 font-normal italic" title="Calculated from yearly plan">
                ~{{ subscription.getReportingMonthlyCalculated(mainCurrency|default(null))|number_format(2, '.', ' ') }}
            </span>
        {% endif %}
    </td>
    <td class="py-3.5 px-4 text-end">
        {% if mainCurrency is defined and mainCurrency and subscription.isPendingReview(mainCurrency) %}
            <span class="text-slate-300 font-normal" title="{{ 'subscription.totals_exclude_review'|trans({'%count%': 1}) }}">—</span>
        {% elseif subscription.isYearly() %}
            <span class="font-bold text-slate-900">{{ subscription.getReportingYearlyCalculated(mainCurrency|default(null))|number_format(2, '.', ' ') }}</span>
        {% else %}
            <span class="text-xs text-slate-500 font-normal italic" title="Calculated from monthly plan">
                ~{{ subscription.getReportingYearlyCalculated(mainCurrency|default(null))|number_format(2, '.', ' ') }}
            </span>
        {% endif %}
    </td>
    <td class="py-3.5 px-4 text-end">
        <div class="inline-flex items-center gap-1.5 justify-end">
            <a href="{{ path('app_subscription_edit', {'id': subscription.id}) }}"
               data-turbo-frame="modal"
               class="inline-flex items-center px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg shadow-2xs transition-all">
                <i class="fa-solid fa-pen text-[10px] mr-1.5 text-slate-400"></i>
                {{ "edit"|trans }}
            </a>

            <a href="{{ path('app_subscription_delete', {'id': subscription.id}) }}"
               data-turbo-frame="modal"
               class="inline-flex items-center px-2.5 py-1 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-white border border-rose-200/80 hover:bg-rose-50 rounded-lg shadow-2xs transition-all">
                <i class="fa-solid fa-trash text-[10px] mr-1.5 text-rose-400"></i>
                {{ 'delete'|trans }}
            </a>
        </div>
    </td>
</tr>
