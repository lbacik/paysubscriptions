<div
        data-controller="subscription-table-modal"
        data-action="turbo:before-cache@window->subscription-table-modal#close"
>
    <dialog
            data-subscription-table-modal-target="dialog"
            data-action="close->subscription-table-modal#close click->subscription-table-modal#clickOutside"
            class="open:flex bg-color-pri rounded-lg shadow-xl inset-0 w-full md:w-fit md:max-w-[50%] md:min-w-[50%] backdrop:bg-slate-600 backdrop:bg-opacity-80 backdrop:backdrop-blur-sm animate-fade-in"
    >
        <div class="flex grow p-5">
            <div class="grow overflow-auto p-1">

                <turbo-frame
                        id="modal"
                        data-subscription-table-modal-target="dynamicContent"
                        data-action="turbo:before-fetch-request->subscription-table-modal#showLoading"
                        class="aria-busy:opacity-50 transition-opacity"
                >
                    <turbo-stream action="append" target="flash-container">
                        <template>{{ include('partials/_flash_messages.html.twig') }}</template>
                    </turbo-stream>

                    {% for stream in app.flashes('stream') %}
                        {{ stream|raw }}
                    {% endfor %}
                </turbo-frame>

