{# Upcoming renewals widget: the next five forecast charges derived from the
   signed-in User's own next payment dates. These are forecasts based on
   user-entered data, not recorded transactions, and are shown independently
   of any email reminder opt-in. #}
<section id="upcoming-renewals" aria-label="{{ "dashboard.upcoming_renewals.title"|trans }}">
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs p-6 md:p-8">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h2 class="text-lg font-extrabold text-slate-900 tracking-tight">
                    {{ "dashboard.upcoming_renewals.title"|trans }}
                </h2>
                <p class="mt-1 text-xs text-slate-500">
                    {{ "dashboard.upcoming_renewals.forecast_note"|trans }}
                </p>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200/80 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-700">
                <i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i>
                {{ "dashboard.upcoming_renewals.forecast_badge"|trans }}
            </span>
        </div>

        {% if upcomingRenewals|length > 0 %}
            <ul class="mt-5 divide-y divide-slate-100">
                {% for renewal in upcomingRenewals %}
                    <li class="flex items-center justify-between gap-4 py-3">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-10 h-10 shrink-0 rounded-xl bg-blue-50 text-color-ter flex flex-col items-center justify-center leading-none">
                                <span class="text-sm font-extrabold">{{ renewal.renewalDate|date('d') }}</span>
                                <span class="text-[9px] font-bold uppercase">{{ renewal.renewalDate|date('M') }}</span>
                            </div>
                            <div class="min-w-0">
                                <a href="{{ path('app_subscription_edit', {'id': renewal.subscription.id}) }}"
                                   data-turbo-frame="modal"
                                   class="block font-semibold text-slate-900 hover:text-color-ter hover:underline truncate">
                                    {{ renewal.subscription.name }}
                                </a>
                                <div class="text-xs text-slate-400">
                                    {{ renewal.renewalDate|date('Y-m-d') }}
                                </div>
                            </div>
                        </div>
                        <div class="shrink-0 font-bold text-slate-900 text-end">
                            {{ renewal.subscription.amount|number_format(2, '.', ' ') }}{% if renewal.subscription.currency %} {{ renewal.subscription.currency }}{% endif %}
                            {% set convertedDisplayAmount = renewal.subscription.getConvertedDisplayAmount(mainCurrency|default(null)) %}
                            {% if convertedDisplayAmount is not null %}
                                <div class="text-xs font-normal text-slate-400">≈ {{ convertedDisplayAmount|number_format(2, '.', ' ') }} {{ mainCurrency }}</div>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50/60 p-6 text-center">
                <div class="mx-auto w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center text-sm shadow-2xs">
                    <i class="fa-regular fa-calendar-plus"></i>
                </div>
                <p class="mt-3 text-sm font-bold text-slate-900">
                    {{ "dashboard.upcoming_renewals.empty_title"|trans }}
                </p>
                <p class="mt-1 text-xs text-slate-500">
                    {{ "dashboard.upcoming_renewals.empty_body"|trans }}
                </p>
                <a href="{{ path('app_subscription_new') }}"
                   data-turbo-frame="modal"
                   class="btn-primary inline-flex items-center gap-2 mt-4 px-4 py-2 text-xs">
                    <i class="fa-solid fa-plus text-[10px]"></i>
                    {{ "dashboard.upcoming_renewals.add_first"|trans }}
                </a>
            </div>
        {% endif %}
    </div>
</section>
