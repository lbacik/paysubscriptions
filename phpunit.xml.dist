<?xml version="1.0" encoding="UTF-8"?>

<!-- https://docs.phpunit.de/en/13.4/configuration.html -->
<!-- Zero-deprecation gate: any deprecation fails the run (failOnDeprecation,
     failOnPhpunitDeprecation), with no exception. A future suppression needs
     its own issue with justification and a narrow <deprecationFilter> linking
     to it. No baseline. #[IgnoreDeprecations] is only for a test that
     deliberately exercises deprecated behavior. See docs/testing.md. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         displayDetailsOnAllIssues="true"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <ini name="memory_limit" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <!-- Google's documented reCAPTCHA test keys: they always validate and
             exist so pages embedding the widget (contact) render without real
             credentials. Real environment variables still win (no force), and
             the a11y scan CI job sets the same pair explicitly. -->
        <server name="GOOGLE_RECAPTCHA_SITE_KEY" value="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI" />
        <server name="GOOGLE_RECAPTCHA_SECRET" value="6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- doctrine/deprecations caches its mode on first use and Symfony sets
             it only at the first kernel boot. -->
        <server name="DOCTRINE_DEPRECATIONS" value="trigger" force="true" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <!-- Symfony, Doctrine and DebugClassLoader report deprecations through
         @trigger_error(), so suppressed deprecations must count. -->
    <source ignoreSuppressionOfDeprecations="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>

        <deprecationTrigger>
            <function>trigger_deprecation</function>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::triggerIfCalledFromOutside</method>
        </deprecationTrigger>
    </source>

    <extensions>
        <!-- Enables DebugClassLoader (vendor/src class-level deprecations). -->
        <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension" />
        <!-- Wraps each test in a rolled-back transaction; see
             #[DAMA\DoctrineTestBundle\PHPUnit\SkipDatabaseRollback]. -->
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
        <!-- Applies #[Zenstruck\Foundry\Attribute\ResetDatabase]; replaces the
             deprecated ResetDatabase/Factories traits. -->
        <bootstrap class="Zenstruck\Foundry\PHPUnit\FoundryExtension" />
    </extensions>
</phpunit>
