# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
# Dummy values so the container builds without production secrets. No test
# contacts these backends: reCAPTCHA is replaced per-test with
# App\Tests\Double\FakeReCaptcha, the newsletter transport is in-memory, and
# mail delivery is observed through the test message logger.
GOOGLE_RECAPTCHA_SITE_KEY='test-site-key'
GOOGLE_RECAPTCHA_SECRET='test-secret'
JSON_HUB_PROJECT='00000000-0000-0000-0000-000000000000'
MAILING_PROVIDER_ROUTING_KEY='test-routing-key'
